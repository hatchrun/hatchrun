# Marks the instance when it was launched as a runner, so that
# hatchrun-agent.service starts only then. An instance launched by hand,
# or by the AWS Marketplace scan, boots and stays up like any other.
[Unit]
Description=hatchrun agent: tell whether the instance was launched as a runner
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/hatchrun-agent detect
StandardOutput=journal+console
StandardError=journal+console
