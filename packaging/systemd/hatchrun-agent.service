# Runs one CI job, then powers the instance off. The launch
# template sets InstanceInitiatedShutdownBehavior=terminate, so power-off
# ends the instance.
[Unit]
Description=hatchrun agent: run one CI job
Wants=network-online.target docker.socket hatchrun-launch.service
After=network-online.target docker.socket hatchrun-launch.service
# Only CI launches get here. A unit skipped by a condition triggers
# neither action below, so other launches are not powered off.
ConditionPathExists=/run/hatchrun/launch
# Power off on success and on failure alike, so an instance that could not
# claim its job never sits idle and billed. Override with a drop-in
# setting both to none when debugging an image.
SuccessAction=poweroff
FailureAction=poweroff

[Service]
Type=exec
ExecStart=/usr/bin/hatchrun-agent
Restart=no
# The agent cancels the job on SIGTERM and waits for the steps to stop.
KillMode=mixed
TimeoutStopSec=45
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
